# Settings for the common Compose stack; each app has its own .env.example.
API_PORT=3000
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Application metadata storage
DB_PORT=5432
POSTGRES_USER=verdant
POSTGRES_PASSWORD=verdant_local
POSTGRES_DB=verdant

# Independently launched local sample databases for live connections
TEST_POSTGRES_PORT=5433
TEST_POSTGRES_USER=demo
TEST_POSTGRES_PASSWORD=demo_postgres
TEST_POSTGRES_DB=commerce
TEST_MYSQL_PORT=3307
TEST_MYSQL_ROOT_PASSWORD=demo_mysql_root
TEST_MYSQL_USER=demo
TEST_MYSQL_PASSWORD=demo_mysql
TEST_MYSQL_DB=commerce
TEST_MONGO_PORT=27018
TEST_MONGO_ROOT_USER=admin
TEST_MONGO_ROOT_PASSWORD=demo_mongo_root
TEST_MONGO_USER=demo
TEST_MONGO_PASSWORD=demo_mongo
TEST_MONGO_DB=commerce

# Local development key only. Generate a private 32-byte hex key for other environments.
CONNECTION_ENCRYPTION_KEY=40f30196f782cf59efcb04d0f09f11b024c9f324fc6eaa143117c0a31276604b

# Passwordless email auth. These values are only for local development.
AUTH_ACCESS_TOKEN_KEY=39c600fce274bc67528bbf102216302cd7800af69340bd1a52ca1ca32ce22403
AUTH_REFRESH_TOKEN_KEY=7b77dd43079f69083f2668ddcb120643b0869ed97d9efa923a089687de48917b
AUTH_OTP_PEPPER=1ce2b431d65223bdde239d1de28007315acd1a13eaa656b12117fdca768db0e3
AUTH_ACCESS_TOKEN_TTL_HOURS=12
AUTH_REFRESH_TOKEN_TTL_HOURS=168
AUTH_BOOTSTRAP_EMAIL=developer@databaseenjoyer.local
# Keep both empty locally to print the OTP in server logs.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Read-only sample users (the demo/admin users above bootstrap the servers).
SAMPLE_POSTGRES_DB=pagila
SAMPLE_POSTGRES_USER=enjoyer
SAMPLE_POSTGRES_PASSWORD=enjoyer_postgres
SAMPLE_MYSQL_DB=sakila
SAMPLE_MYSQL_USER=enjoyer
SAMPLE_MYSQL_PASSWORD=enjoyer_mysql
SAMPLE_MONGO_DB=restaurants
SAMPLE_MONGO_AUTH_SOURCE=restaurants
SAMPLE_MONGO_USER=enjoyer
SAMPLE_MONGO_PASSWORD=enjoyer_mongo
# Addresses used by the app container to reach compose.samples.yaml through the Docker host.
SAMPLE_POSTGRES_HOST=host.docker.internal
SAMPLE_POSTGRES_PORT=5433
SAMPLE_MYSQL_HOST=host.docker.internal
SAMPLE_MYSQL_PORT=3307
SAMPLE_MONGO_HOST=host.docker.internal
SAMPLE_MONGO_PORT=27018
