# Copy to .env.production on the server. Never commit the real file.
WEB_PORT=8080
CORS_ORIGIN=https://db.example.com

# Metadata catalog used only by DatabaseEnjoyer.
POSTGRES_USER=database_enjoyer
POSTGRES_PASSWORD=CHANGE_ME_METADATA_PASSWORD
POSTGRES_DB=database_enjoyer
CONNECTION_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
AUTH_ACCESS_TOKEN_KEY=CHANGE_ME_INDEPENDENT_RANDOM_SECRET
AUTH_REFRESH_TOKEN_KEY=CHANGE_ME_ANOTHER_INDEPENDENT_RANDOM_SECRET
AUTH_OTP_PEPPER=CHANGE_ME_THIRD_INDEPENDENT_RANDOM_SECRET
AUTH_ACCESS_TOKEN_TTL_HOURS=12
AUTH_REFRESH_TOKEN_TTL_HOURS=168
AUTH_BOOTSTRAP_EMAIL=owner@example.com
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM_EMAIL="DatabaseEnjoyer <login@example.com>"
